# ===========================================
# 宠物领养平台 - 环境变量配置模板
# ===========================================
# 使用说明：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 修改以下配置为你的实际值（所有配置都是必填项）
# 3. .env 文件已被 .gitignore 排除，不会上传到Git
# 4. 启动服务前必须先配置好此文件
# ===========================================

# ----- Nacos注册中心 -----
NACOS_SERVER_ADDR=你的Nacos地址:端口

# ----- MySQL数据库配置 -----
DB_HOST=你的MySQL主机地址
DB_PORT=你的MySQL端口号
DB_USERNAME=你的MySQL用户名
DB_PASSWORD=你的MySQL密码

# ----- Redis配置 -----
REDIS_HOST=你的Redis主机地址
REDIS_PORT=你的Redis端口号
REDIS_PASSWORD=你的Redis密码

# ----- RabbitMQ配置 -----
RABBITMQ_HOST=你的RabbitMQ主机地址
RABBITMQ_PORT=你的RabbitMQ端口号
RABBITMQ_USERNAME=你的RabbitMQ用户名
RABBITMQ_PASSWORD=你的RabbitMQ密码

# ----- 服务端口配置（必填）-----
GATEWAY_PORT=网关服务端口
USER_SERVICE_PORT=用户服务端口
ADMIN_SERVICE_PORT=管理员服务端口
SOCIAL_SERVICE_PORT=社交服务端口
CHAT_SERVICE_PORT=聊天服务端口
DONATION_SERVICE_PORT=捐赠服务端口
RECRUITMENT_SERVICE_PORT=招聘服务端口
STORY_SERVICE_PORT=故事服务端口
PET_SERVICE_PORT=宠物服务端口
TIPS_SERVICE_PORT=贴士服务端口

# ----- 阿里云OSS配置（用于文件上传）-----
OSS_ENDPOINT=https://oss-cn-你的区域.aliyuncs.com
OSS_ACCESS_KEY_ID=你的AccessKey ID
OSS_ACCESS_KEY_SECRET=你的AccessKey Secret
OSS_BUCKET_NAME=你的Bucket名称

# ----- 阿里云DashScope API（用于AI功能）-----
DASHSCOPE_API_KEY=你的DashScope API Key

# ----- JWT密钥（非常重要！必须设置为强密码）-----
# 建议：使用至少32位的随机字符串
# 可以用命令生成：openssl rand -base64 32
JWT_SECRET_KEY=你的JWT签名密钥（必须设置）
